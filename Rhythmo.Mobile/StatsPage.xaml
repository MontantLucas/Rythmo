<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Rhythmo.Mobile.Controls"
             x:Class="Rhythmo.Mobile.StatsPage"
             Title="Stats"
             Shell.NavBarIsVisible="True">
    <Grid Padding="{OnIdiom Phone='20,12,20,16', Default='28,18'}"
          RowDefinitions="Auto,*">

        <controls:RhythmSectionTabs x:Name="StatsTabs" Grid.Row="0" />

        <RefreshView x:Name="StatsRefresh"
                     Grid.Row="1"
                     Margin="0,12,0,0">
            <ScrollView>
                <VerticalStackLayout Spacing="20"
                                     Padding="0,0,0,32">

                    <VerticalStackLayout x:Name="OverviewPanel" Spacing="22">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource RhythmCaption}" Text="Volume cumulé" />
                            <Label x:Name="OverviewVolumeLabel"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="32"
                                   TextColor="{StaticResource RhythmAccent}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                            <VerticalStackLayout Spacing="4">
                                <Label Style="{StaticResource RhythmCaption}" Text="Séances terminées" />
                                <Label x:Name="OverviewCountLabel"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="24"
                                       TextColor="{StaticResource RhythmTextPrimary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Style="{StaticResource RhythmCaption}" Text="Énergie estimée" />
                                <Label x:Name="OverviewKcalLabel"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="24"
                                       TextColor="{StaticResource RhythmTextPrimary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="SessionsPanel"
                                         Spacing="12"
                                         IsVisible="False">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Style="{StaticResource RhythmCaption}"
                                   VerticalOptions="Center"
                                   Text="Toucher une ligne pour le détail." />
                            <Button Grid.Column="1"
                                    Style="{StaticResource RhythmBtnGhost}"
                                    Padding="12,8"
                                    FontSize="13"
                                    Text="Nettoyer"
                                    Clicked="OnCleanHistoryClicked" />
                        </Grid>
                        <CollectionView x:Name="HistoryList"
                                        EmptyView="Pas encore de séance enregistrée."
                                        SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,0,0,16" ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label FontFamily="OpenSansSemibold"
                                                   FontSize="16"
                                                   LineBreakMode="TailTruncation"
                                                   Text="{Binding SessionTitle}" />
                                            <Label FontSize="13"
                                                   TextColor="{StaticResource RhythmTextSecondary}"
                                                   Text="{Binding SubLine}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               VerticalOptions="Center"
                                               FontSize="18"
                                               TextColor="{StaticResource RhythmTextSecondary}"
                                               Text="›" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ProgressPanel"
                                         Spacing="12"
                                         IsVisible="False">
                        <Label Style="{StaticResource RhythmCaption}"
                               Text="Charge max du jour, pour chaque séance terminée." />
                        <controls:RhythmSearchField x:Name="ProgressExerciseSearch"
                                                    Placeholder="Rechercher un exercice…"
                                                    TextChanged="OnProgressExerciseSearchChanged" />
                        <controls:RhythmOptionSelector x:Name="ProgressExerciseSelector"
                                                       Title="Exercice"
                                                       Placeholder="Choisir un exercice"
                                                       SemanticProperties.Hint="Sélectionne un mouvement"
                                                       SelectedIndexChanged="OnProgressExerciseSelected" />
                        <GraphicsView x:Name="ProgressChart"
                                      BackgroundColor="{StaticResource RhythmBg}"
                                      HeightRequest="278" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
