<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Rhythmo.Mobile.StatsPage"
             Title="Statistiques"
             Shell.NavBarIsVisible="True">
    <Grid Padding="{OnIdiom Phone='20,12,20,16', Default='28,18'}">
        <RefreshView x:Name="StatsRefresh">
            <ScrollView>
                <VerticalStackLayout Spacing="16" Padding="0,0,0,28">
                    <Grid x:Name="PeriodHost" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" />
                    <Label x:Name="RangeLabel" Style="{StaticResource RhythmCaption}" />
                    <Border x:Name="CompareCard" Padding="16" StrokeThickness="0" BackgroundColor="{StaticResource RhythmSurface1}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCompareTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Profil musculaire" FontFamily="OpenSansSemibold" FontSize="18" />
                            <Label Style="{StaticResource RhythmCaption}" Text="Comparer les rangs validés." />
                            <GraphicsView x:Name="SelfRadar" HeightRequest="220" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Padding="16" StrokeThickness="0" BackgroundColor="{StaticResource RhythmSurface1}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHistoryTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Historique d’entraînement" FontFamily="OpenSansSemibold" FontSize="18" />
                            <Label Style="{StaticResource RhythmCaption}" Text="Par exercice ou par séance." />
                        </VerticalStackLayout>
                    </Border>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource RhythmCaption}" Text="Séances" />
                            <Label x:Name="SessionsLabel" FontFamily="OpenSansSemibold" FontSize="22" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Style="{StaticResource RhythmCaption}" Text="Exercices" />
                            <Label x:Name="ExercisesLabel" FontFamily="OpenSansSemibold" FontSize="22" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label Style="{StaticResource RhythmCaption}" Text="Volume" />
                            <Label x:Name="VolumeLabel" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{StaticResource RhythmAccent}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
