<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Rhythmo.Mobile.Controls"
             x:Class="Rhythmo.Mobile.DashboardPage"
             Title="Accueil"
             Shell.NavBarIsVisible="False">
    <Grid>
        <RefreshView x:Name="DashRefresh">
            <ScrollView>
            <VerticalStackLayout Padding="{OnIdiom Phone='20', Default='28'}"
                                 Spacing="20"
                                 MaximumWidthRequest="840"
                                 HorizontalOptions="Center">

                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource RhythmH2}"
                           Text="Muscles" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Style="{StaticResource RhythmBtnSecondary}"
                                Text="Défis de la semaine"
                                FontSize="13"
                                Padding="8,10"
                                Clicked="OnGoWeeklyClicked" />
                        <Grid Grid.Column="1">
                            <Button Style="{StaticResource RhythmBtnSecondary}"
                                    Text="Quêtes de rang"
                                    FontSize="13"
                                    Padding="8,10"
                                    Clicked="OnGoQuestsClicked" />
                            <Border x:Name="QuestCountBadge"
                                    IsVisible="False"
                                    Padding="7,2"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource RhythmAccent}"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    TranslationX="6"
                                    TranslationY="-6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label x:Name="QuestCountLabel"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="11"
                                       TextColor="{StaticResource RhythmBg}" />
                            </Border>
                        </Grid>
                    </Grid>
                </VerticalStackLayout>

                <controls:AnatomyBodyView x:Name="BodyMap"
                                          GroupOpened="OnGroupOpened" />
            </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
