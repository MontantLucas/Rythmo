<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Rhythmo.Mobile.Controls"
             x:Class="Rhythmo.Mobile.DashboardPage"
             Title="Accueil"
             Shell.NavBarIsVisible="False">
    <Grid>
        <RefreshView x:Name="DashRefresh">
            <ScrollView>
            <VerticalStackLayout Padding="{OnIdiom Phone='20', Default='28'}"
                                 Spacing="20"
                                 MaximumWidthRequest="840"
                                 HorizontalOptions="Center">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Grid.Column="0"
                           Style="{StaticResource RhythmH2}"
                           Text="Muscles"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap" />
                    <Grid Grid.Column="1" VerticalOptions="Center">
                        <Button Style="{StaticResource RhythmBtnGhost}"
                                Text="Défis →"
                                Clicked="OnGoQuestsClicked" />
                        <Border x:Name="QuestCountBadge"
                                IsVisible="False"
                                Padding="7,2"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource RhythmAccent}"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                TranslationX="8"
                                TranslationY="-8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label x:Name="QuestCountLabel"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="11"
                                   TextColor="{StaticResource RhythmBg}" />
                        </Border>
                    </Grid>
                </Grid>

                <controls:AnatomyBodyView x:Name="BodyMap"
                                          GroupOpened="OnGroupOpened" />
            </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
