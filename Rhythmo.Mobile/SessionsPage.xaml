<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Rhythmo.Mobile.Controls"
             x:Class="Rhythmo.Mobile.SessionsPage"
             Title="Séances"
             Shell.NavBarIsVisible="False">
    <Grid>
        <Grid RowDefinitions="Auto,*"
              Padding="{OnIdiom Phone='20,16', Default='28,22'}">
            <VerticalStackLayout Spacing="10">
                <Label Style="{StaticResource RhythmH2}" Text="Séances" />
                <controls:RhythmSectionTabs x:Name="HubTabs" />
            </VerticalStackLayout>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid x:Name="SessionsPane">
                    <RefreshView x:Name="SessionsRefresh">
                        <Grid RowDefinitions="Auto,*">
                            <controls:RhythmSearchField x:Name="SessionSearchBar"
                                                        Placeholder="Rechercher une séance…"
                                                        TextChanged="OnSessionSearchChanged" />

                            <CollectionView x:Name="SessionsList"
                                              Grid.Row="1"
                                              Margin="0,14,0,96"
                                              SelectionMode="Single"
                                              SelectionChanged="OnSessionSelectionChanged"
                                              EmptyView="Crée ta première séance depuis le bouton +.">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,0,0,18">
                                            <VerticalStackLayout Spacing="6">
                                                <Label FontFamily="OpenSansSemibold"
                                                       FontSize="18"
                                                       LineBreakMode="TailTruncation"
                                                       Text="{Binding Title}"
                                                       TextColor="{StaticResource RhythmTextPrimary}" />
                                                <Label FontSize="13"
                                                       LineBreakMode="TailTruncation"
                                                       Text="{Binding ChipTags}"
                                                       TextColor="{StaticResource RhythmAccent}" />
                                                <Label FontSize="12"
                                                       Text="{Binding MetaLine}"
                                                       TextColor="{StaticResource RhythmTextSecondary}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </RefreshView>
                </Grid>

                <ContentView x:Name="CatalogHost" IsVisible="False" />
            </Grid>
        </Grid>

        <VerticalStackLayout x:Name="FabColumn"
                             HorizontalOptions="End"
                             VerticalOptions="End"
                             Margin="0,0,22,92"
                             Spacing="12">
            <VerticalStackLayout x:Name="FabMenuPanel"
                                 IsVisible="False"
                                 Spacing="10"
                                 HorizontalOptions="End">
                <Button Padding="16,12"
                        CornerRadius="16"
                        BackgroundColor="{StaticResource RhythmSurface2}"
                        TextColor="{StaticResource RhythmTextPrimary}"
                        Text="Nouvelle séance"
                        Clicked="OnFabNewSession" />
                <Button Padding="16,12"
                        CornerRadius="16"
                        BackgroundColor="{StaticResource RhythmSurface2}"
                        TextColor="{StaticResource RhythmTextPrimary}"
                        Text="Séance à la volée"
                        Clicked="OnFabAdHoc" />
                <Button Padding="16,12"
                        CornerRadius="16"
                        BackgroundColor="{StaticResource RhythmSurface2}"
                        TextColor="{StaticResource RhythmTextPrimary}"
                        Text="Démarrage rapide"
                        Clicked="OnFabQuickStart" />
                <Button Padding="16,12"
                        CornerRadius="16"
                        BackgroundColor="{StaticResource RhythmSurface2}"
                        TextColor="{StaticResource RhythmTextSecondary}"
                        Text="Importer…"
                        Clicked="OnFabImport" />
            </VerticalStackLayout>
            <Button x:Name="FabMainBtn"
                    WidthRequest="58"
                    HeightRequest="58"
                    CornerRadius="29"
                    Padding="0"
                    FontSize="26"
                    Text="+"
                    BackgroundColor="{StaticResource RhythmAccent}"
                    TextColor="{StaticResource RhythmBg}"
                    SemanticProperties.Hint="Actions rapides séances"
                    Clicked="OnFabMainClicked" />
        </VerticalStackLayout>

        <Grid x:Name="SheetOverlay"
              IsVisible="False"
              BackgroundColor="{StaticResource RhythmOverlay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentView Grid.Row="0" BackgroundColor="Transparent">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSheetBackdropTapped" />
                </ContentView.GestureRecognizers>
            </ContentView>

            <Border Grid.Row="1"
                    Margin="12,0,12,24"
                    Padding="22"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource RhythmSurface2}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="SheetTitleLabel"
                           FontFamily="OpenSansSemibold"
                           FontSize="20"
                           LineBreakMode="TailTruncation"
                           TextColor="{StaticResource RhythmTextPrimary}" />
                    <Button Style="{StaticResource RhythmBtnPrimary}"
                            Text="Démarrer cette séance"
                            Clicked="OnSheetStart" />
                    <Button Style="{StaticResource RhythmBtnSecondary}"
                            Text="Modifier"
                            Clicked="OnSheetEdit" />
                    <Button Style="{StaticResource RhythmBtnGhost}"
                            Text="Dupliquer"
                            Clicked="OnSheetDuplicate" />
                    <Button TextColor="{StaticResource RhythmWarning}"
                            BackgroundColor="Transparent"
                            Text="Supprimer la séance"
                            Clicked="OnSheetDelete" />
                    <Button Style="{StaticResource RhythmBtnGhost}"
                            Text="Fermer"
                            Clicked="OnSheetClose" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
