<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Rhythmo.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Rhythmo.Mobile"
    Title="Rhythmo"
    Shell.NavBarHasShadow="False">

    <TabBar>
        <ShellContent
            Title="Accueil"
            ContentTemplate="{DataTemplate pages:DashboardPage}"
            Icon="tab_home.svg"
            Route="DashboardPage" />
        <ShellContent
            Title="Séances"
            ContentTemplate="{DataTemplate pages:SessionsPage}"
            Icon="tab_sessions.svg"
            Route="SessionsPage" />
        <ShellContent
            Title="Amis"
            ContentTemplate="{DataTemplate pages:FriendsPage}"
            Icon="tab_friends.svg"
            Route="FriendsPage" />
        <ShellContent
            Title="⋯"
            ContentTemplate="{DataTemplate pages:MorePage}"
            Icon="tab_more.svg"
            Route="MorePage" />
    </TabBar>
</Shell>
